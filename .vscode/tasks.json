{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "doctor",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/doctor.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "syscfg",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/syscfg.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "configure",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/build.sh",
      "args": [
        "configure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/build.sh",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "rebuild",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/build.sh",
      "args": [
        "rebuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "hex",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/build.sh",
      "args": [
        "target",
        "hex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "bin",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/build.sh",
      "args": [
        "target",
        "bin"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-elf",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/flash.sh",
      "args": [
        "dslite-elf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-hex",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/flash.sh",
      "args": [
        "dslite-hex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "hex"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/flash.sh",
      "args": [
        "pyocd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "flash-jlink",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/flash.sh",
      "args": [
        "jlink"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "debug-server",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/debug_server.sh",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "debug-server-kill",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/debug_server.sh",
      "args": [
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "debug-prepare",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build",
        "debug-server"
      ],
      "problemMatcher": []
    },
    {
      "label": "serial",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/serial.sh",
      "args": [
        "${input:serialPort}",
        "${input:serialBaud}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "imu-monitor",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/python_tool.sh",
      "args": [
        "imu-monitor",
        "${input:serialPort}",
        "${input:serialBaud}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "vehicle-dashboard",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/python_tool.sh",
      "args": [
        "vehicle-dashboard",
        "${input:serialPort}",
        "${input:serialBaud}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "web-dashboard",
      "type": "process",
      "command": "${workspaceFolder}/scripts/dev/python_tool.sh",
      "args": [
        "web-dashboard",
        "${input:serialPort}",
        "${input:serialBaud}",
        "${input:webDashboardPort}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "pickString",
      "description": "选择串口设备",
      "options": [
        "auto",
        "/dev/ttyACM0",
        "/dev/ttyACM1",
        "/dev/ttyUSB0",
        "/dev/ttyUSB1"
      ],
      "default": "auto"
    },
    {
      "id": "serialBaud",
      "type": "pickString",
      "description": "选择波特率",
      "options": [
        "115200"
      ],
      "default": "115200"
    },
    {
      "id": "webDashboardPort",
      "type": "pickString",
      "description": "选择 WebDashboard 端口",
      "options": [
        "8765",
        "8766",
        "8767"
      ],
      "default": "8765"
    }
  ]
}
